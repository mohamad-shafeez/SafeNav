# --- AI Services ---
GEMINI_API_KEY=your_gemini_api_key_here
PLANNER_API_KEY=your_planner_api_key_here

# --- Weather & AQI APIs ---
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_KEY=your_openweather_api_key_here
AQI_TOKEN=your_waqi_api_token_here

# --- Image Search API ---
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- Routing Incidents API ---
TOMTOM_API_KEY=your_tomtom_api_key_here

# --- Server Settings ---
FLASK_ENV=development
SECRET_KEY=your_flask_secret_key_here

# --- Firebase Fallback Configuration ---
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# --- Browser Origin Allowlist ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Firebase Admin ---
# Prefer FIREBASE_SERVICE_ACCOUNT_JSON in production. The JSON value must be
# supplied by the deployment secret manager; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=serviceAccountKey.json

# --- Admin access ---
# Comma-separated Firebase account emails allowed to call /api/admin/*.
ADMIN_EMAILS=

# --- Vault encryption ---
# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=